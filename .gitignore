# ---- Secrets -----------------------------------------------------------------
# config.h ships with placeholders; if you split real credentials into a
# separate file, ignore it here.
firmware/esp32_controller/secrets.h

# ---- Arduino / PlatformIO build artifacts ------------------------------------
build/
.pio/
*.elf
*.bin
*.hex
*.map

# ---- TouchDesigner -----------------------------------------------------------
# TD writes backups and a build folder next to the .toe file.
touchdesigner/Backup/
*.toe.*
*.toeexpand/

# ---- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
/assets/

# ---- Web app -----------------------------------------------------------------
# *.bin above is for firmware builds; glTF models need their .bin buffers.
!web/public/models/**/*.bin
node_modules/

# ---- Python ------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
